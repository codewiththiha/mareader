{
  "compilerOptions": {
    // Sources live in tools/, emitted JavaScript lands in scripts/ — a
    // directory that holds NOTHING but generated output, so both git and the
    // Trunk watcher can ignore it wholesale instead of maintaining a list of
    // individual files (a list that silently breaks `trunk serve` with a
    // rebuild loop the day someone adds a tool).
    "rootDir": "tools",
    "outDir": "scripts",
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "strict": true,
    "noImplicitOverride": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "declaration": false,
    "sourceMap": false,
    "removeComments": false,
    "useDefineForClassFields": true
  },
  "include": ["tools/**/*.ts"]
}
