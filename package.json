{
  "name": "mareader",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "build:css": "tailwindcss -i styles/input.css -o styles.css --minify",
    "watch:css": "tailwindcss -i styles/input.css -o styles.css --watch",
    "build:ts": "tsc --noEmit --project tsconfig.json && tsc --project tsconfig.tools.json && node ./tools/bundle-engine.mjs",
    "build": "npm run build:ts && node tools/build-runtimes.mjs",
    "dev:frontend": "npm run build:ts && node tools/build-runtimes.mjs --dev && node tools/serve-runtimes.mjs",
    "test:runtime": "node tools/verify-legacy-runtime.mjs && node --test tests/runtime/*.test.mjs"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@types/node": "^26.2.0",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.6.3"
  }
}
