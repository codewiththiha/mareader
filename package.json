{
  "name": "pdf-reader",
  "private": true,
  "version": "0.7.0",
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "build:css": "tailwindcss -i styles/input.css -o styles.css --minify",
    "watch:css": "tailwindcss -i styles/input.css -o styles.css --watch",
    "build:ts": "tsc --noEmit --project tsconfig.json && tsc --project tsconfig.tools.json && node ./tools/bundle-engine.mjs",
    "watch:ts": "tsc --project tsconfig.tools.json && node ./tools/bundle-engine.mjs",
    "check:ts": "tsc --noEmit --project tsconfig.json && tsc --noEmit --project tsconfig.tools.json",
    "build": "npm run build:ts && npm run build:css && trunk build --release"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@types/node": "^26.2.0",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.6.3"
  }
}
