/dist/
/target/

# macOS
.DS_Store

# Claude config (may contain local secrets)
.claude/

# Generated by the tailwind pre_build hook
/styles.css

# Generated by the tsc and esbuild pre_build hooks from public/pdfEngine.ts and
# tools/*.ts (Trunk runs the hooks on every build; `npm run build:ts`
# regenerates them locally; CI runs `npm ci && npm run build:ts` before any test
# step). `scripts/` holds nothing but the compiled tooling — the sources live in
# `tools/` — so the whole directory is ignored, and Trunk's watcher ignores it
# for the same reason.
/public/pdfEngine.js
/public/readerEngine.js
/public/bake.worker.js
/public/engine/*.js
/scripts/

# Node
/node_modules/

# Local-only tooling
/.script/
/.env
CONTRACTS.md
contracts.md
bun.lock
.st.txt
.claude-shell-test.txt

# Local web build output (wasm-bindgen webgen + assembled static root)
/webgen/
/webroot/

# Local e2e entry page (served via webroot; intentionally not versioned)
/e2e-index.html
